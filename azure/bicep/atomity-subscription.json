{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.33.93.31351",
      "templateHash": "815095899420337387"
    },
    "description": "Atomity read-only connection for Azure, per subscription: Reader on each listed subscription and Storage Blob Data Reader on the billing export storage account. It creates role assignments only. It does not create the Service Principal or the Cost Management export. It needs no management group rights. Deploy it with az deployment sub create, from any one of the subscriptions. To grant Reader on a whole management group instead, use main.bicep."
  },
  "parameters": {
    "atomityServicePrincipalObjectId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "metadata": {
        "description": "Object ID of Atomity's Service Principal in your tenant. Get it with: az ad sp show --id c4b84012-e86e-4ea0-9c42-5e015c1c30f4 --query id -o tsv"
      }
    },
    "subscriptionIds": {
      "type": "array",
      "minLength": 1,
      "metadata": {
        "description": "Subscription IDs to grant Reader on. The deployment can run from any one of them. Subscriptions you add later are not covered until you deploy again with them listed."
      }
    },
    "storageAccountSubscriptionId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "metadata": {
        "description": "Subscription ID where your billing export storage account is located."
      }
    },
    "storageAccountResourceGroupName": {
      "type": "string",
      "minLength": 1,
      "metadata": {
        "description": "Resource group name where your billing export storage account is located."
      }
    },
    "storageAccountName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 24,
      "metadata": {
        "description": "Name of the existing storage account designated to receive the FOCUS cost export."
      }
    }
  },
  "resources": [
    {
      "copy": {
        "name": "subscriptionReaderAssignments",
        "count": "[length(union(parameters('subscriptionIds'), createArray()))]"
      },
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[format('atomity-sub-reader-{0}', union(parameters('subscriptionIds'), createArray())[copyIndex()])]",
      "subscriptionId": "[union(parameters('subscriptionIds'), createArray())[copyIndex()]]",
      "location": "[deployment().location]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "atomityServicePrincipalObjectId": {
            "value": "[parameters('atomityServicePrincipalObjectId')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.33.93.31351",
              "templateHash": "11597588734698685839"
            }
          },
          "parameters": {
            "atomityServicePrincipalObjectId": {
              "type": "string",
              "metadata": {
                "description": "The Object ID of Atomity's Service Principal."
              }
            }
          },
          "variables": {
            "readerRoleId": "acdd72a7-3385-48ef-bd42-f606fba81ae7"
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(subscription().id, parameters('atomityServicePrincipalObjectId'), variables('readerRoleId'))]",
              "properties": {
                "roleDefinitionId": "[tenantResourceId('Microsoft.Authorization/roleDefinitions', variables('readerRoleId'))]",
                "principalId": "[parameters('atomityServicePrincipalObjectId')]",
                "principalType": "ServicePrincipal",
                "description": "Atomity read-only inventory and metrics access on this subscription."
              }
            }
          ],
          "outputs": {
            "roleAssignmentId": {
              "type": "string",
              "value": "[subscriptionResourceId('Microsoft.Authorization/roleAssignments', guid(subscription().id, parameters('atomityServicePrincipalObjectId'), variables('readerRoleId')))]"
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "atomity-storage-role-deployment",
      "subscriptionId": "[parameters('storageAccountSubscriptionId')]",
      "resourceGroup": "[parameters('storageAccountResourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "atomityServicePrincipalObjectId": {
            "value": "[parameters('atomityServicePrincipalObjectId')]"
          },
          "storageAccountName": {
            "value": "[parameters('storageAccountName')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.33.93.31351",
              "templateHash": "11257689636314609509"
            }
          },
          "parameters": {
            "atomityServicePrincipalObjectId": {
              "type": "string",
              "metadata": {
                "description": "The Object ID of Atomity's Service Principal."
              }
            },
            "storageAccountName": {
              "type": "string",
              "metadata": {
                "description": "The target storage account name."
              }
            }
          },
          "variables": {
            "storageBlobDataReaderRoleId": "2a2b9908-6ea1-4ae2-8e65-a410df84e7d1"
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[format('Microsoft.Storage/storageAccounts/{0}', parameters('storageAccountName'))]",
              "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), parameters('atomityServicePrincipalObjectId'), variables('storageBlobDataReaderRoleId'))]",
              "properties": {
                "roleDefinitionId": "[tenantResourceId('Microsoft.Authorization/roleDefinitions', variables('storageBlobDataReaderRoleId'))]",
                "principalId": "[parameters('atomityServicePrincipalObjectId')]",
                "principalType": "ServicePrincipal",
                "description": "Atomity read-only access to billing export Parquet files in this storage account."
              }
            }
          ],
          "outputs": {
            "roleAssignmentId": {
              "type": "string",
              "value": "[extensionResourceId(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), parameters('atomityServicePrincipalObjectId'), variables('storageBlobDataReaderRoleId')))]"
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "readerSubscriptions": {
      "type": "array",
      "metadata": {
        "description": "The subscriptions where the Reader role was assigned."
      },
      "value": "[union(parameters('subscriptionIds'), createArray())]"
    },
    "storageAccount": {
      "type": "string",
      "metadata": {
        "description": "The storage account receiving the export."
      },
      "value": "[parameters('storageAccountName')]"
    },
    "storageRoleAssignmentId": {
      "type": "string",
      "metadata": {
        "description": "Confirmation of the storage account role assignment ID."
      },
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', parameters('storageAccountSubscriptionId'), parameters('storageAccountResourceGroupName')), 'Microsoft.Resources/deployments', 'atomity-storage-role-deployment'), '2022-09-01').outputs.roleAssignmentId.value]"
    }
  }
}
